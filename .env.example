# TortSignal Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# DATABASE (Required for persistence)
# =============================================================================
DATABASE_URL=postgresql://tortsignal:tortsignal@localhost:5432/tortsignal

# =============================================================================
# API KEYS - Data Sources (Free tiers available)
# =============================================================================

# SEER Cancer Registry API
# Get key at: https://seer.cancer.gov/seerstat/software/
SEER_API_KEY=

# OpenFDA (optional - improves rate limits from 1k to 120k/day)
# Get key at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# NCBI/PubMed (optional - improves rate limits from 3 to 10 req/sec)
# Get key at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# =============================================================================
# API KEYS - Paid Services
# =============================================================================

# Anthropic Claude (required for entity extraction from court filings)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# UniCourt Enterprise API (required for court filing discovery)
# Contact: https://unicourt.com/products/enterprise-api/
UNICOURT_CLIENT_ID=
UNICOURT_CLIENT_SECRET=

# =============================================================================
# APPLICATION CONFIG
# =============================================================================
LOG_LEVEL=INFO
DISCOVERY_DAYS=7
DISCOVERY_LIMIT=100
